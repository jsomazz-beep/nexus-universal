# =====================================================================
#  Intelligence Hub v2.0 — Variáveis de Ambiente
#  Copie para .env e preencha com suas chaves
# =====================================================================

# ── Identificação HTTP (obrigatório — coloque seu email) ──────────────
HTTP_USER_AGENT=IntelligenceHub/2.0 (+seuemail@empresa.com)

# ── NewsAPI.org (plano gratuito) ──────────────────────────────────────
# Registe-se em: https://newsapi.org/register
# 100 req/dia grátis
NEWSAPI_KEY=

# ── The Guardian Open Platform (plano gratuito) ───────────────────────
# Registe-se em: https://open-platform.theguardian.com/access/
# 12 millhões de artigos, sem limite de req no plano gratuito
GUARDIAN_API_KEY=

# ── New York Times API (plano gratuito) ───────────────────────────────
# Registe-se em: https://developer.nytimes.com/
# 500 req/dia, 5 req/min
NYTIMES_API_KEY=

# ── Anthropic AI (opcional, para sumarização por IA) ─────────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Configurações de execução ─────────────────────────────────────────
# Sobrescreve config.yaml se preenchido
NEWS_MAX_NEWS=
NEWS_REPORT_THEME=
NEWS_PRIORITY_KEYWORDS=
