# Nexus Intelligence — Environment Variables
# Copy this file to .env and fill in as needed

# Optional: NewsAPI key (newsapi.org) for extra coverage
NEWSAPI_KEY=

# Optional: Gemini API key for AI-powered summaries
GEMINI_API_KEY=

# Optional: custom user agent
HTTP_USER_AGENT=NexusIntelligence/2.0 (+contato@empresa.com)

# Optional: Override report language (pt, en, es)
OUTPUT_LANGUAGE=pt
